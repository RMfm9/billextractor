# Copy this file to .env.local for local development with `vercel dev`.
# In production, set these in Vercel: Project -> Settings -> Environment Variables.

# Azure Document Intelligence resource ("Keys and Endpoint" page)
AZURE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com
AZURE_API_KEY=your-azure-key-here

# Postgres connection string.
# If you create a database via Vercel Storage (Postgres, powered by Neon),
# POSTGRES_URL is injected automatically - you don't need to set it by hand.
# If you're using your own standalone Neon project instead, set DATABASE_URL.
# POSTGRES_URL=postgres://...
# DATABASE_URL=postgres://...

# Vercel Blob (used for the daily log files).
# BLOB_READ_WRITE_TOKEN is injected automatically once you create a Blob
# store under Vercel Storage and connect it to this project.
# BLOB_READ_WRITE_TOKEN=...

# Optional but recommended: protects /api/cron/cleanup-logs from being
# triggered by anyone who guesses the URL. Vercel automatically sends this
# as a Bearer token when it calls the cron job.
CRON_SECRET=replace-with-a-long-random-string
